{
  "name": "fan-decide-miniapp",
  "private": true,
  "version": "2.7.0",
  "description": "饭决 FAN·DECIDE - 微信小程序 (Taro 4 + React), 与 H5 共用 shared/ 业务层",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "//browserslist": "微信小程序不能按现代浏览器出包: 微信开发者工具/服务端的编译器与部分 Android 旧内核不认可可选链 ?. 与空值合并 ??, 会判成『非法的文件』导致代码包被拒、真机白屏。这里显式压到 ES2015 语法层级, 让 babel 把 ?. / ?? 降级掉。详见 docs/miniapp-troubleshooting.md",
  "browserslist": [
    "iOS >= 10",
    "Android >= 5",
    "Chrome >= 53",
    "Safari >= 10"
  ],
  "dependencies": {
    "@babel/runtime": "^8.0.0-alpha.17",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/router": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.2.1",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.0",
    "sass": "^1.77.0",
    "typescript": "^5.6.0",
    "webpack": "^5.94.0"
  }
}
