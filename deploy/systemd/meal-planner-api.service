# /etc/systemd/system/meal-planner-api.service
[Unit]
Description=AI 每周营养菜谱工具 - FastAPI 后端
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=meal
Group=meal
WorkingDirectory=/srv/meal-planner/backend
EnvironmentFile=/srv/meal-planner/.env
Environment=PYTHONUNBUFFERED=1
# 单机 2 vCPU 建议 2~4 个 worker; worker 内部已有生成并发上限
ExecStart=/srv/meal-planner/.venv/bin/python -m uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1 \
    --no-server-header \
    --timeout-keep-alive 30
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

# 安全收口
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/meal-planner/logs
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meal-planner-api

[Install]
WantedBy=multi-user.target
