# 饭决 FAN·DECIDE - 环境变量模板
#
# 用法:
#   cp .env.example .env       然后填入真实值
#   bash scripts/setup_local.sh   # 或者让它自动生成一份本地可用的 .env
#
# ⚠ .env 已在 .gitignore 中, 千万不要提交; 本文件里的值全是占位符, 可以提交。
# ⚠ 服务启动时会拒绝带占位密码的连接串 (见 backend/app/config.py),
#   所以"忘改密码"会直接起不来, 而不是静悄悄连上一个错库。
#
# 命名规则: APP__<段>__<字段> (双下划线分层)
# 优先级:   环境变量 > .env > config/default.yaml > 代码默认值

# ===== 数据库 (必填, MySQL 8.0, 默认端口 3306) =====
# 这是连接串的**唯一来源**。应用、alembic 迁移、备份脚本、运维脚本都读它,
# 不要在 config/default.yaml 或任何代码里再写一份 —— 抄一份就意味着改密码时要改两处,
# 漏改的那处会以一个"看起来配好了"的样子留下来。
#
# 格式: mysql+aiomysql://<用户>:<密码>@<主机>:3306/<库名>?charset=utf8mb4
# 注意: 密码里若含 @ : / ? # & 等特殊字符, 必须做 URL 编码 (例如 @ 写成 %40),
#       否则连接串会被解析错 —— 表现为"密码明明对了却报 Access denied"。
APP__DATABASE__URL=mysql+aiomysql://<user>:<password>@127.0.0.1:3306/meal_planner?charset=utf8mb4
APP__DATABASE__ECHO=false
# 连接池 (可选, 默认 10 / 20 / 1800 / 30)
# APP__DATABASE__POOL_SIZE=10
# APP__DATABASE__MAX_OVERFLOW=20
# APP__DATABASE__POOL_RECYCLE=1800
# APP__DATABASE__POOL_TIMEOUT=30

# ===== 应用 (必填) =====
# 注意: 应用段下的字段需要写两层, APP__APP__<字段>
APP__APP__DEBUG=false
# 生产域名, 用于生成飞书回调与前端跳转
APP__APP__BASE_URL=https://meal.example.com

# ===== 认证 (必填, 至少 32 字符) =====
# 生成方式: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP__AUTH__JWT_SECRET=please_replace_with_a_random_secret_at_least_32_chars
APP__AUTH__COOKIE_SECURE=true
# 本地开发专用: 开启后可用「本地开发登录」绕过飞书, 生产环境必须为 false
APP__AUTH__DEV_LOGIN=false

# ===== 飞书开放平台 (扫码登录必填) =====
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
APP__FEISHU__REDIRECT_URI=https://meal.example.com/api/auth/feishu/callback
APP__FEISHU__LOGIN_SUCCESS_REDIRECT=/
# 以下三项用于飞书 Bot 消息推送与事件回调 (可选, 公网务必配置)
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_DEFAULT_CHAT_ID=

# ===== 生成配额 (可选) =====
# 首次生成与重新生成各算一份额度, 互不占用。
# 想让重新生成完全不限次, 把它调到很大即可 (例如 9999)。
# 也可以直接改 config/default.yaml 的 menu 段, 效果相同。
# APP__MENU__DAILY_GENERATION_LIMIT=3
# APP__MENU__DAILY_REGENERATE_LIMIT=10

# ===== 微信小程序 (可选, 用于微信一键登录) =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== 定时推送 (可选, 默认关闭) =====
# 多 worker 部署时只能让一个实例打开, 否则每个 worker 都会推一遍 (见 deploy/README.md)
APP__SCHEDULER__ENABLED=false
APP__SCHEDULER__TIMEZONE=Asia/Shanghai
# 调度器默认复用 APP__DATABASE__URL, 不要在这里再抄一份连接串。
# 只有确实要让它连另一个库时才设:
# APP__SCHEDULER__DB_URL=mysql+aiomysql://<user>:<password>@127.0.0.1:3306/meal_planner?charset=utf8mb4
# 时间写法: "HH:MM" 每天 / "SUN HH:MM" 每周某天 / 5 段 crontab; 留空表示不注册该任务
# APP__SCHEDULER__DAILY_MENU_PUSH=08:00
# APP__SCHEDULER__EVENING_CHECK=17:30
# APP__SCHEDULER__WEEKLY_GENERATION=SUN 20:00
# APP__SCHEDULER__EXPIRY_CHECK=10:00
# APP__SCHEDULER__DAILY_SCRAPE=09:00

# ===== LLM (至少配置一个) =====
GLM4_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
# 一个 Key 都没有时, 可临时用本地演示模式跑通全链路 (返回固定菜单, 不联网)
# 生产环境必须为 false
APP__LLM__DEMO=false

# 拍照识别 (冰箱入库) 用的视觉模型: 默认复用 GLM4_API_KEY, 只换模型名。
# 没有 Key 时接口返回 503, 前端把按钮置灰并引导手动添加, 不影响其他功能。
# 通义千问用户改成: APP__LLM__VISION__MODEL=qwen-vl-max
# APP__LLM__VISION__MODEL=glm-4v-flash
# APP__LLM__VISION__DAILY_LIMIT=20
# 图片超过这个大小直接拒绝 (MB)
# APP__LLM__VISION__MAX_IMAGE_MB=6

# ===== 补单出口 (可选) =====
# 本期不采集商品数据, 只生成"点一下去下单"的搜索链接。
# 小程序里想直接打开小象超市小程序, 就填它的 AppID; 留空则退化成复制清单。
# APP__PLATFORMS__XIAOXIANG__MINIAPP_APP_ID=
# 起送价 (元), 用于补单卡片的凑单提示; 填 0 表示不提示凑单
# APP__PLATFORMS__XIAOXIANG__MIN_ORDER_AMOUNT=20
# 想换成别的商超, 只改链接模板即可, 关键字会被 URL 编码
# APP__PLATFORMS__XIAOXIANG__SEARCH_TEMPLATE=https://i.waimai.meituan.com/search/?keyword={keyword}

# ===== System One 决策模型 (可选; 默认后端: 开源 Laya) =====
# 只做判断(选择/打分/是非), 不生成文本。本项目用它把用户的口语诉求
# ("今天想吃清淡点的, 别太辣") 解析成结构化意图, 打分排序仍然走规则。
#
# Laya 是 Apache-2.0 开源实现, 本地推理, 无需 Key、无网络调用:
#   pip install laya            (会带上 torch + transformers)
#   pip install -e ".[system-one]"
# 首次运行会下载 421M 权重(约 1.7GB)。国内网络建议:
#   export HF_ENDPOINT=https://hf-mirror.com
# APP__SYSTEM_ONE__ENABLED=true
# APP__SYSTEM_ONE__PROVIDER=laya              # laya | jev | adapter | rule
# APP__SYSTEM_ONE__LAYA_CHECKPOINT=multilingual   # 中文必选 multilingual 或 auto
# APP__SYSTEM_ONE__LAYA_DEVICE=                    # 留空自动(macOS 用 mps)
# APP__SYSTEM_ONE__MIN_CONFIDENCE=0.55
#
# 想换回 TypeSafe 官方 Jev(闭源 API, 需白名单开白):
#   TYPESAFE_API_KEY=tsk_xxx
#   APP__SYSTEM_ONE__PROVIDER=jev
#
# 机器上装不了 torch 时的退路(接本机 LM Studio 等 OpenAI 兼容端点):
# APP__SYSTEM_ONE__PROVIDER=adapter
# APP__SYSTEM_ONE__ADAPTER_BASE_URL=http://127.0.0.1:1234/v1
# APP__SYSTEM_ONE__ADAPTER_MODEL=zai-org/glm-4.6v-flash

# ===== 跨域 (仅前后端分域部署时需要, JSON 数组) =====
# APP__APP__CORS_ORIGINS=["https://meal.example.com"]
